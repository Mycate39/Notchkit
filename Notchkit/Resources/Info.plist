<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Notchkit</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.andeolchenaux.notchkit</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>notchkit</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Notchkit pilote la lecture (lecture, pause, morceau suivant) de Music et Spotify depuis l'encoche.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Notchkit analyse le son joué par votre Mac pour animer les barres de l'égaliseur en temps réel. Le son n'est ni enregistré ni envoyé.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Notchkit affiche vos prochains événements dans l'encoche et vous les rappelle quelques minutes avant.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Notchkit affiche vos prochains événements dans l'encoche et vous les rappelle quelques minutes avant.</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Notchkit</string>
	<key>NSLocationUsageDescription</key>
	<string>Notchkit utilise votre position approximative pour afficher la météo locale.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Notchkit utilise votre position approximative pour afficher la météo locale.</string>
</dict>
</plist>
