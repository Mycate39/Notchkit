  "strings" : {
    "NSCameraUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit shows a mirror view of your camera in the notch, only while the Webcam widget is open. Nothing is recorded."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit affiche un miroir de votre caméra dans l'encoche, uniquement pendant que le widget Webcam est ouvert. Rien n'est enregistré."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit shows your reminders in the notch and lets you check them off or add new ones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit affiche vos rappels dans l'encoche et vous permet de les cocher ou d'en ajouter."
          }
        }
      }
    },
    "NSRemindersUsageDescription" : {
