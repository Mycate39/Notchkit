    "NSAppleEventsUsageDescription" : {
      "comment" : "Message d'autorisation affiché par macOS",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit steuert die Wiedergabe in Musik und Spotify und schaltet den Dunkelmodus mit System Events um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit controls playback in Music and Spotify and switches Dark Mode with System Events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit controla la reproducción en Música y Spotify y cambia el modo oscuro con System Events."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit pilote la lecture de Musique et Spotify et bascule le mode sombre avec System Events."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkitは、ミュージックとSpotifyの再生を操作し、System Eventsでダークモードを切り替えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Notchkit controla a reprodução no Música e no Spotify e alterna o modo escuro com o System Events."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit 会控制音乐和 Spotify 的播放，并通过 System Events 切换深色模式。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Message d'autorisation affiché par macOS",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit analysiert den Klang, der auf deinem Mac läuft, um die Equalizer-Balken in Echtzeit zu animieren. Der Ton wird nie aufgenommen oder gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit analyzes the sound playing on your Mac to animate the equalizer bars in real time. Audio is never recorded or sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit analiza el sonido que suena en tu Mac para animar las barras del ecualizador en tiempo real. El audio nunca se graba ni se envía a ningún sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit analyse le son joué par votre Mac pour animer les barres de l'égaliseur en temps réel. Le son n'est ni enregistré ni envoyé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkitは、Macで再生中のサウンドを解析してイコライザバーをリアルタイムに動かします。オーディオが録音・送信されることはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Notchkit analisa o som tocando no seu Mac para animar as barras do equalizador em tempo real. O áudio nunca é gravado nem enviado para lugar nenhum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit 会分析 Mac 上正在播放的声音，实时驱动均衡器柱状动画。声音绝不会被录制或发送到任何地方。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Message d'autorisation affiché par macOS",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit zeigt deine nächsten Ereignisse in der Notch und erinnert dich einige Minuten vor Beginn daran."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit shows your upcoming events in the notch and reminds you a few minutes before they start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit muestra tus próximos eventos en el notch y te avisa unos minutos antes de que empiecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit affiche vos prochains événements dans l'encoche et vous les rappelle quelques minutes avant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkitは、次のイベントをノッチに表示し、始まる数分前にお知らせします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Notchkit mostra seus próximos eventos no notch e avisa alguns minutos antes de começarem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit 会在刘海中显示你即将到来的事件，并在开始前几分钟提醒你。"
          }
        }
      }
    },
    "NSCalendarsUsageDescription" : {
