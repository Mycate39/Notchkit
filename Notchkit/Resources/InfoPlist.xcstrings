    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Privacy - Reminders Full Access Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit zeigt deine Erinnerungen in der Notch und lässt dich sie abhaken oder neue hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit shows your reminders in the notch and lets you check them off or add new ones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit muestra tus recordatorios en el notch y te permite marcarlos como hechos o añadir otros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit affiche vos rappels dans l'encoche et vous permet de les cocher ou d'en ajouter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkitは、リマインダーをノッチに表示し、チェックを付けたり新しく追加したりできるようにします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Notchkit mostra seus lembretes no notch e permite marcá-los como concluídos ou adicionar novos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit 会在刘海中显示你的提醒事项，并让你勾选完成或添加新的提醒事项。"
          }
        }
      }
    },
