    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit zeigt in der Notch ein Spiegelbild deiner Kamera, nur solange das Webcam-Widget geöffnet ist. Es wird nichts aufgenommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit shows a mirror view of your camera in the notch, only while the Webcam widget is open. Nothing is recorded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit muestra un espejo de tu cámara en el notch, solo mientras el widget Cámara web está abierto. No se graba nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit affiche un miroir de votre caméra dans l'encoche, uniquement pendant que le widget Webcam est ouvert. Rien n'est enregistré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkitは、ウェブカメラウィジェットを開いている間だけ、ノッチにカメラのミラー表示を出します。何も録画されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Notchkit mostra um espelho da sua câmera no notch, só enquanto o widget Webcam está aberto. Nada é gravado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在网络摄像头小组件打开时，Notchkit 会在刘海中显示相机的镜像画面。不会录制任何内容。"
          }
        }
      }
    },
