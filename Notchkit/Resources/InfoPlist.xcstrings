    "NSAppleEventsUsageDescription" : {
      "comment" : "Message d'autorisation affiché par macOS",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit controls playback in Music and Spotify, switches Dark Mode with System Events, and reads the folder open in Terminal for the Git widget."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit pilote la lecture de Music et Spotify, bascule le mode sombre avec System Events et lit le dossier ouvert dans le Terminal pour le widget Git."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Message d'autorisation affiché par macOS",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit analyzes the sound playing on your Mac to animate the equalizer bars in real time. Audio is never recorded or sent anywhere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit analyse le son joué par votre Mac pour animer les barres de l'égaliseur en temps réel. Le son n'est ni enregistré ni envoyé."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Message d'autorisation affiché par macOS",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit shows your upcoming events in the notch and reminds you a few minutes before they start."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit affiche vos prochains événements dans l'encoche et vous les rappelle quelques minutes avant."
          }
        }
      }
    },
    "NSCalendarsUsageDescription" : {
