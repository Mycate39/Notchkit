    "NSLocationUsageDescription" : {
      "comment" : "Message d'autorisation affiché par macOS",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit nutzt deinen ungefähren Standort, um das lokale Wetter zu zeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit uses your approximate location to show the local weather."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit usa tu ubicación aproximada para mostrar el tiempo local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit utilise votre position approximative pour afficher la météo locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkitは、おおよその位置情報を使って現地の天気を表示します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Notchkit usa sua localização aproximada para mostrar o tempo local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit 会使用你的大致位置来显示本地天气。"
          }
        }
      }
    },
