    "Glissez les widgets pour les réordonner ou les changer de page. Cliquez sur un widget pour changer sa taille. Astuce : un clic droit sur un widget dans l'encoche offre les mêmes options." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag widgets to reorder them or move them to another page. Click a widget to change its size. Tip: right-clicking a widget in the notch offers the same options."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez les widgets pour les réordonner ou les changer de page. Cliquez sur un widget pour changer sa taille. Astuce : un clic droit sur un widget dans l'encoche offre les mêmes options."
          }
        }
      }
    },
