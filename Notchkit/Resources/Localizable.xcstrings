    "Posez une question : je réponds avec Apple Intelligence, directement sur votre Mac." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag mich, was du willst: Ich antworte mit Apple Intelligence, direkt auf deinem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask me anything: I answer with Apple Intelligence, right on your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntame lo que quieras: respondo con Apple Intelligence, en tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez une question : je réponds avec Apple Intelligence, directement sur votre Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なんでも聞いてください。Apple Intelligenceを使って、このMac上で答えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte o que quiser: eu respondo com a Apple Intelligence, direto no seu Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想问什么都可以：我会用 Apple 智能在你的 Mac 上回答。"
          }
        }
      }
    },
