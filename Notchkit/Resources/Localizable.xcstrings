    "Services en lecture seule : préférez une clé Stripe à accès restreint (lecture des paiements). GitHub utilise le jeton de son propre widget." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibgeschützte Dienste: Nutze am besten einen eingeschränkten Stripe-Schlüssel (Zahlungen lesen). GitHub nutzt das Token seines eigenen Widgets."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read-only services: prefer a restricted Stripe key (read payments). GitHub uses its own widget's token."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servicios de solo lectura: mejor una clave de Stripe restringida (lectura de pagos). GitHub usa el token de su propio widget."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Services en lecture seule : préférez une clé Stripe à accès restreint (lecture des paiements). GitHub utilise le jeton de son propre widget."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み取り専用のサービス：制限付きのStripeキー（支払いの読み取り）がおすすめです。GitHubは専用ウィジェットのトークンを使います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serviços somente leitura: prefira uma chave restrita da Stripe (leitura de pagamentos). O GitHub usa o token do próprio widget."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只读服务：建议使用受限的 Stripe 密钥（读取付款）。GitHub 使用其小组件自己的令牌。"
          }
        }
      }
    },
