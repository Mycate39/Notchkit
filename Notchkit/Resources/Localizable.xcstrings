    "Volume et luminosité aux touches du clavier, encoche qui évite les menus, traduction de la sélection, verrouillage du clavier." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautstärke- und Helligkeitstasten, eine Notch, die Menüs freilässt, Übersetzung der Auswahl und Tastatursperre."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume and brightness keys, a notch that stays clear of menus, translating the selection, and keyboard lock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teclas de volumen y brillo, un notch que deja libres los menús, traducción de la selección y bloqueo del teclado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume et luminosité aux touches du clavier, encoche qui évite les menus, traduction de la sélection, verrouillage du clavier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量と明るさのキー、メニューを避けるノッチ、選択部分の翻訳、キーボードロック。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teclas de volume e brilho, um notch que deixa os menus livres, tradução da seleção e bloqueio do teclado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量和亮度键、避开菜单的刘海、翻译所选内容和键盘锁。"
          }
        }
      }
    },
    "Volume, luminosité, volume des apps… Sinon, ils prennent la couleur d'accent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautstärke, Helligkeit, Lautstärke pro App … Sonst nutzen sie die Akzentfarbe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume, brightness, per-app volume… Otherwise they use the accent color."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volumen, brillo, volumen por app… Si no, usan el color de acento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume, luminosité, volume des apps… Sinon, ils prennent la couleur d'accent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量、明るさ、App別の音量… 指定しない場合はアクセントカラーを使います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume, brilho, volume por app… Senão, usam a cor de destaque."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量、亮度、按 App 调节音量… 否则使用强调色。"
          }
        }
      }
    },
    "Vos activités vivent dans l'encoche" : {
      "localizations" : {
        "de" : {
