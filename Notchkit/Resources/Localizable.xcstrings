    "« Réduire les animations » est activé dans macOS : les animations sont désactivées." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bewegung reduzieren“ ist in macOS aktiviert: Animationen sind deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Reduce motion” is turned on in macOS: animations are disabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Reducir movimiento» está activado en macOS: las animaciones están desactivadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Réduire les animations » est activé dans macOS : les animations sont désactivées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSで「視差効果を減らす」がオンになっているため、アニメーションはオフです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Reduzir movimento” está ativado no macOS: as animações estão desativadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 已开启“减弱动态效果”：动画已关闭。"
          }
        }
      }
    },
    "« run » affiche la commande pendant qu'elle tourne, puis une coche verte ou une croix rouge avec sa durée. Lancez notchkit --help pour toutes les options." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„run“ zeigt den Befehl, solange er läuft, dann ein grünes Häkchen oder ein rotes Kreuz mit seiner Dauer. Mit notchkit --help siehst du alle Optionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“run” shows the command while it runs, then a green check or a red cross with how long it took. Run notchkit --help for every option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«run» muestra el comando mientras se ejecuta y luego una marca verde o una cruz roja con su duración. Ejecuta notchkit --help para ver todas las opciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« run » affiche la commande pendant qu'elle tourne, puis une coche verte ou une croix rouge avec sa durée. Lancez notchkit --help pour toutes les options."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「run」は実行中のコマンドを表示し、終了すると所要時間とともに緑のチェックか赤いバツを表示します。すべてのオプションはnotchkit --helpで確認できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“run” mostra o comando enquanto ele roda e, depois, um visto verde ou um X vermelho com a duração. Rode notchkit --help para ver todas as opções."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“run”会在命令运行时显示它，结束后显示绿色对勾或红色叉号及用时。运行 notchkit --help 查看所有选项。"
          }
        }
      }
    },
    "« Verre » utilise le Liquid Glass de macOS 26 ; en mode encoche (réelle ou simulée), le haut reste noir pour se fondre avec la découpe de l'écran." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Glas“ nutzt das Liquid Glass von macOS 26; im Notch-Modus (echt oder simuliert) bleibt der obere Teil schwarz, um mit der Bildschirmaussparung zu verschmelzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Glass” uses the Liquid Glass of macOS 26; in notch mode (real or simulated), the top stays black to blend in with the screen cutout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Cristal» usa el Liquid Glass de macOS 26; en modo notch (real o simulado), la parte superior sigue negra para fundirse con el recorte de la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Verre » utilise le Liquid Glass de macOS 26 ; en mode encoche (réelle ou simulée), le haut reste noir pour se fondre avec la découpe de l'écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ガラス」はmacOS 26のLiquid Glassを使います。ノッチモード（実物またはシミュレーション）では、画面の切り欠きになじむよう上部は黒のままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vidro” usa o Liquid Glass do macOS 26; no modo notch (real ou simulado), a parte de cima fica preta para se misturar ao recorte da tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
