            "value" : "ロック解除アニメーションは「Apple Face ID」（Mau Ali）と「Fingerprint Touch ID」（Himanshu Patel）を元にしています。Lottie Simple Licenseに基づきます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animações de desbloqueio adaptadas de “Apple Face ID” (Mau Ali) e “Fingerprint Touch ID” (Himanshu Patel), sob a Lottie Simple License."
          }
        },
