    "Nécessaire pour couper la veille capot fermé. macOS demandera une fois votre mot de passe administrateur." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nötig, um den Mac bei geschlossenem Deckel wach zu halten. macOS fragt einmal nach deinem Administratorpasswort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to keep your Mac awake with the lid closed. macOS will ask for your administrator password once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesario para mantener el Mac activo con la tapa cerrada. macOS pedirá una vez tu contraseña de administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessaire pour couper la veille capot fermé. macOS demandera une fois votre mot de passe administrateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蓋を閉じたままMacをスリープさせないために必要です。macOSが一度だけ管理者パスワードを求めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessário para manter o Mac acordado com a tampa fechada. O macOS pedirá sua senha de administrador uma vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合盖后保持 Mac 唤醒需要此助手。macOS 会请求一次你的管理员密码。"
          }
        }
      }
    },
    "Notchkit installe son assistant pour garder le Mac éveillé capot fermé." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit installiert seine Systemhilfe, um den Mac bei geschlossenem Deckel wach zu halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchkit is installing its helper to keep your Mac awake with the lid closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
