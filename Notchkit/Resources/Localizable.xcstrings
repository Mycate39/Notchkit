    "Faites ces gestes sur la vraie encoche, en haut de l'écran. Chacun se coche tout seul." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probiere diese Gesten an der echten Notch oben am Bildschirm aus. Jede wird automatisch abgehakt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try these gestures on the real notch, at the top of the screen. Each one checks itself off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba estos gestos en el notch real, en la parte superior de la pantalla. Cada uno se marca solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites ces gestes sur la vraie encoche, en haut de l'écran. Chacun se coche tout seul."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面上部の本物のノッチで、これらのジェスチャを試してください。できたものから自動でチェックされます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente estes gestos no notch real, no alto da tela. Cada um é marcado sozinho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在屏幕顶部真正的刘海上试试这些手势。每完成一个就会自动勾选。"
          }
        }
      }
    },
