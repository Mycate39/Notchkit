    "Pour revenir aux réglages : roue dentée de l'encoche dépliée, ou relancez Notchkit depuis le Finder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurück zu den Einstellungen geht es über das Zahnrad der aufgeklappten Notch oder indem du Notchkit erneut im Finder öffnest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To get back to Settings, use the gear in the expanded notch, or open Notchkit again from the Finder."
