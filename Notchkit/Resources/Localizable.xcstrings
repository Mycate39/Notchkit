    "Créez un jeton gratuit sur GitHub (Settings › Developer settings › Personal access tokens), avec l'accès en lecture aux dépôts. Il est gardé dans le trousseau de macOS." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle ein kostenloses Token auf GitHub (Settings › Developer settings › Personal access tokens) mit Lesezugriff auf Repositorys. Es wird im macOS-Schlüsselbund gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a free token on GitHub (Settings › Developer settings › Personal access tokens) with read access to repositories. It is kept in the macOS keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un token gratuito en GitHub (Settings › Developer settings › Personal access tokens) con acceso de lectura a los repositorios. Se guarda en el llavero de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un jeton gratuit sur GitHub (Settings › Developer settings › Personal access tokens), avec l'accès en lecture aux dépôts. Il est gardé dans le trousseau de macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub（Settings › Developer settings › Personal access tokens）で、リポジトリの読み取り権限を持つ無料のトークンを作成してください。macOSのキーチェーンに保存されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie um token gratuito no GitHub (Settings › Developer settings › Personal access tokens) com acesso de leitura aos repositórios. Ele fica guardado nas Chaves do macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 GitHub 上（Settings › Developer settings › Personal access tokens）创建一个对仓库具有读取权限的免费令牌。它会保存在 macOS 钥匙串中。"
          }
        }
      }
    },
