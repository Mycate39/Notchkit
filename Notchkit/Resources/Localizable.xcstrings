    "Chaque autorisation est facultative : sans elle, seule la fonction indiquée est désactivée. Vous pouvez la retirer à tout moment dans les Réglages Système." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Berechtigung ist optional: Ohne sie wird nur die genannte Funktion deaktiviert. Du kannst sie jederzeit in den Systemeinstellungen widerrufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every permission is optional: without it, only the feature listed is turned off. You can revoke it at any time in System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los permisos son opcionales: sin uno, solo se desactiva la función indicada. Puedes retirarlo en cualquier momento en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque autorisation est facultative : sans elle, seule la fonction indiquée est désactivée. Vous pouvez la retirer à tout moment dans les Réglages Système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのアクセス許可も任意です。許可しなくても、該当する機能がオフになるだけです。システム設定でいつでも取り消せます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as permissões são opcionais: sem uma delas, só o recurso indicado é desativado. Você pode revogá-las a qualquer momento em Ajustes do Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每项权限都是可选的：不授予时，只会关闭对应的功能。你可以随时在系统设置中撤销。"
          }
        }
      }
    },
