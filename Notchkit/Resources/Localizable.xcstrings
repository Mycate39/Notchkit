            "value" : "Width"
          }
        }
      }
    },
    "Le fichier téléchargé est corrompu (empreinte différente). Réessayez." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The downloaded file is corrupted (checksum mismatch). Try again."
