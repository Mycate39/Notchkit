    "Garde le Mac éveillé capot fermé, tant qu'un agent travaille ou à la demande, avec des sécurités de batterie et de chaleur." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält deinen Mac bei geschlossenem Deckel wach, solange ein Agent arbeitet oder auf Wunsch, mit Schutz für Batterie und Temperatur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps your Mac awake with the lid closed, while an agent works or on demand, with battery and heat safeguards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene tu Mac activo con la tapa cerrada, mientras un agente trabaja o cuando lo pidas, con protecciones de batería y temperatura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde le Mac éveillé capot fermé, tant qu'un agent travaille ou à la demande, avec des sécurités de batterie et de chaleur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントの作業中や必要なときに、蓋を閉じたままMacをスリープさせません。バッテリーと温度の安全機能付き。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém o Mac acordado com a tampa fechada, enquanto um agente trabalha ou quando você quiser, com proteções de bateria e temperatura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在智能体工作时或按需让 Mac 合盖后保持唤醒，并提供电池和温度保护。"
          }
        }
      }
    },
