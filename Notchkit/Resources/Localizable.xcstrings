          "stringUnit" : {
            "state" : "translated",
            "value" : "登录以来的截屏会显示在这里。"
          }
        }
      }
    },
    "Les captures et enregistrements d'écran de votre session, à glisser où vous voulez." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmfotos und -aufnahmen deiner Sitzung, bereit zum Ziehen an jeden Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots and screen recordings from your session, ready to drag anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas y grabaciones de pantalla de tu sesión, listas para arrastrarlas a cualquier sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
