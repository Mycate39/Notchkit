      }
    },
    "Vos agents IA sur une page entière : la mascotte suit leur travail et l'encoche s'ouvre quand l'un d'eux attend votre réponse." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine KI-Agenten auf einer ganzen Seite: Das Maskottchen verfolgt ihre Arbeit, und die Notch öffnet sich, wenn einer von ihnen auf deine Antwort wartet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your AI agents on a full page: the mascot follows their work and the notch opens when one of them is waiting for your answer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus agentes de IA en una página completa: la mascota sigue su trabajo y el notch se abre cuando uno de ellos espera tu respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos agents IA sur une page entière : la mascotte suit leur travail et l'encoche s'ouvre quand l'un d'eux attend votre réponse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIエージェントを1ページに：マスコットが作業を見守り、どれかがあなたの応答を待つとノッチが開きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus agentes de IA numa página inteira: o mascote acompanha o trabalho deles e o notch se abre quando um deles aguarda sua resposta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 AI 智能体整页呈现：吉祥物跟进它们的工作，其中一个等待你回复时刘海会自动打开。"
          }
        }
      }
    },
    "Vos apps préférées à un clic et l'état du Mac en un coup d'œil." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
