    "Au clic et quand un agent change d'humeur (au travail, en attente de votre réponse, tâche terminée)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Klicken und wenn sich die Stimmung eines Agenten ändert (arbeitet, wartet auf deine Antwort, Aufgabe erledigt)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On click and when an agent's mood changes (working, waiting for your answer, task done)."
          }
        },
