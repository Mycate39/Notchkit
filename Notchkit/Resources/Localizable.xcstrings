            "value" : "ポインタを重ねてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe o ponteiro sobre ele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
