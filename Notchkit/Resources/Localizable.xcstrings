    "Scripts et apps peuvent afficher une progression avec un lien, par exemple :\nopen \"notchkit://activity/update?id=build&title=Compilation&progress=40\"\nopen \"notchkit://activity/end?id=build\"\nopen \"notchkit://timer/start?minutes=5&title=Thé\"" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skripte und Apps können per Link einen Fortschritt anzeigen, zum Beispiel:\nopen \"notchkit://activity/update?id=build&title=Build&progress=40\"\nopen \"notchkit://activity/end?id=build\"\nopen \"notchkit://timer/start?minutes=5&title=Tea\""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts and apps can show progress with a link, for example:\nopen \"notchkit://activity/update?id=build&title=Build&progress=40\"\nopen \"notchkit://activity/end?id=build\"\nopen \"notchkit://timer/start?minutes=5&title=Tea\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los scripts y las apps pueden mostrar un progreso con un enlace, por ejemplo:\nopen \"notchkit://activity/update?id=build&title=Build&progress=40\"\nopen \"notchkit://activity/end?id=build\"\nopen \"notchkit://timer/start?minutes=5&title=Tea\""
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts et apps peuvent afficher une progression avec un lien, par exemple :\nopen \"notchkit://activity/update?id=build&title=Compilation&progress=40\"\nopen \"notchkit://activity/end?id=build\"\nopen \"notchkit://timer/start?minutes=5&title=Thé\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリプトやAppはリンクで進行状況を表示できます。例：\nopen \"notchkit://activity/update?id=build&title=Build&progress=40\"\nopen \"notchkit://activity/end?id=build\"\nopen \"notchkit://timer/start?minutes=5&title=Tea\""
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts e apps podem mostrar um progresso com um link, por exemplo:\nopen \"notchkit://activity/update?id=build&title=Build&progress=40\"\nopen \"notchkit://activity/end?id=build\"\nopen \"notchkit://timer/start?minutes=5&title=Tea\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚本和 App 可以通过链接显示进度，例如：\nopen \"notchkit://activity/update?id=build&title=Build&progress=40\"\nopen \"notchkit://activity/end?id=build\"\nopen \"notchkit://timer/start?minutes=5&title=Tea\""
          }
        }
