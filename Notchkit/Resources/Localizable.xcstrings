          "stringUnit" : {
            "state" : "translated",
            "value" : "指针一碰就能打开的便签，随手记下想法。"
          }
        }
      }
    },
    "Un léger clic quand vous ouvrez l'encoche, changez de page, réglez le volume ou le minuteur, ou touchez une commande (trackpad Force Touch)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein leichtes Klicken, wenn du die Notch öffnest, die Seite wechselst, Lautstärke oder Timer einstellst oder ein Bedienelement drückst (Force Touch-Trackpad)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A light click when you open the notch, change pages, adjust the volume or the timer, or press a control (Force Touch trackpad)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ligero toque al abrir el notch, cambiar de página, ajustar el volumen o el temporizador, o pulsar un control (trackpad Force Touch)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un léger clic quand vous ouvrez l'encoche, changez de page, réglez le volume ou le minuteur, ou touchez une commande (trackpad Force Touch)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチを開く、ページを切り替える、音量やタイマーを調整する、コントロールを押すときの軽いクリック感（感圧タッチトラックパッド）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um leve clique ao abrir o notch, mudar de página, ajustar o volume ou o timer, ou pressionar um controle (trackpad Force Touch)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开刘海、切换页面、调节音量或计时器，或按下控制项时的轻微点按感（力度触控板）。"
          }
        }
      }
    },
    "Un miroir rapide pour vérifier votre allure avant une réunion." : {
      "localizations" : {
