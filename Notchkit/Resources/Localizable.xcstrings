    "Animations façon Face ID au déverrouillage, pendant Touch ID et pendant la saisie d'un mot de passe." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID–style animations when unlocking, during Touch ID, and while typing a password."
          }
        },
        "fr" : {
          "stringUnit" : {
