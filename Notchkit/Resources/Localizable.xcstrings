    "Musique, heure et batterie, rien de plus." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik, Uhrzeit und Batterie, sonst nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Music, time, and battery, nothing more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Música, hora y batería, nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musique, heure et batterie, rien de plus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽、時刻、バッテリーだけ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Música, hora e bateria, nada mais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有音乐、时间和电池。"
          }
        }
      }
    },
    "Musique, minuteur, téléchargement : l'activité en cours s'affiche autour de l'encoche, entourée de sa couleur. Les autres deviennent des bulles. Survolez une bulle pour la commander sans ouvrir l'encoche : pause, morceau suivant, arrêt du minuteur." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik, Timer, Downloads: Die laufende Aktivität erscheint rund um die Notch, in ihrer Farbe umrandet. Andere Aktivitäten werden zu Blasen. Bewege den Zeiger auf eine Blase, um sie zu steuern, ohne die Notch zu öffnen: Pause, nächster Titel, Timer stoppen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Music, timers, downloads: the current activity shows around the notch, outlined in its color. Other activities become bubbles. Hover a bubble to control it without opening the notch: pause, next track, stop the timer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Música, temporizadores, descargas: la actividad en curso aparece alrededor del notch, con el contorno de su color. Las demás actividades se convierten en burbujas. Pasa el puntero sobre una burbuja para controlarla sin abrir el notch: pausa, canción siguiente, detener el temporizador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musique, minuteur, téléchargement : l'activité en cours s'affiche autour de l'encoche, entourée de sa couleur. Les autres deviennent des bulles. Survolez une bulle pour la commander sans ouvrir l'encoche : pause, morceau suivant, arrêt du minuteur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽、タイマー、ダウンロード：進行中のアクティビティはノッチのまわりに、その色の輪郭つきで表示されます。ほかのアクティビティはバブルになります。バブルにポインタを重ねると、ノッチを開かずに操作できます：一時停止、次の曲、タイマーの停止。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Música, timers, downloads: a atividade em andamento aparece em volta do notch, contornada na cor dela. As outras atividades viram bolhas. Passe o ponteiro sobre uma bolha para controlá-la sem abrir o notch: pausar, próxima música, parar o timer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音乐、计时器、下载：进行中的活动显示在刘海周围，并以其颜色描边。其他活动变为气泡。将指针移到气泡上即可在不打开刘海的情况下控制它：暂停、下一首、停止计时器。"
          }
        }
      }
    },
    "Ne pas cacher les menus de l'app active" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menüs der aktiven App nicht verdecken"
