    "Affiche la progression des téléchargements de Brave, Chrome, Safari et Firefox. macOS demande l'accès au dossier Téléchargements la première fois." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Fortschritt von Downloads in Brave, Chrome, Safari und Firefox. macOS fragt beim ersten Mal nach Zugriff auf den Ordner „Downloads“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows download progress from Brave, Chrome, Safari, and Firefox. macOS asks for access to the Downloads folder the first time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el progreso de las descargas de Brave, Chrome, Safari y Firefox. macOS pide acceso a la carpeta Descargas la primera vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la progression des téléchargements de Brave, Chrome, Safari et Firefox. macOS demande l'accès au dossier Téléchargements la première fois."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brave、Chrome、Safari、Firefoxのダウンロード進行状況を表示します。初回はmacOSが「ダウンロード」フォルダへのアクセスを求めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o progresso dos downloads do Brave, Chrome, Safari e Firefox. O macOS pede acesso à pasta Downloads na primeira vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示 Brave、Chrome、Safari 和 Firefox 的下载进度。首次使用时 macOS 会请求访问“下载”文件夹。"
          }
        }
      }
    },
    "Affiche une fausse encoche sur les écrans qui n'en ont pas, pour tester le rendu." : {
