    "Le compteur a besoin de l'autorisation Enregistrement de l'écran. L'écran n'est jamais enregistré : Notchkit compte seulement les images affichées." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zähler braucht die Berechtigung für Bildschirmaufnahme. Dein Bildschirm wird nie aufgenommen: Notchkit zählt nur die angezeigten Bilder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The counter needs the Screen Recording permission. Your screen is never recorded: Notchkit only counts the frames shown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contador necesita el permiso de Grabación de pantalla. Tu pantalla nunca se graba: Notchkit solo cuenta los fotogramas mostrados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compteur a besoin de l'autorisation Enregistrement de l'écran. L'écran n'est jamais enregistré : Notchkit compte seulement les images affichées."
          }
        },
        "ja" : {
