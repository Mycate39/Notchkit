    "Page trop chargée : les widgets seront rétrécis. Réduisez une taille ou déplacez un widget." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seite zu voll: Die Widgets werden verkleinert. Verkleinere ein Widget oder verschiebe eines."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page too full: widgets will be shrunk. Reduce a size or move a widget."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Página demasiado llena: los widgets se reducirán. Reduce un tamaño o mueve un widget."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page trop chargée : les widgets seront rétrécis. Réduisez une taille ou déplacez un widget."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページがいっぱいです：ウィジェットが縮小されます。サイズを小さくするか、ウィジェットを移動してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Página cheia demais: os widgets serão reduzidos. Diminua um tamanho ou mova um widget."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "页面太满：小组件将被缩小。请缩小某个小组件或将其移走。"
          }
        }
      }
    },
