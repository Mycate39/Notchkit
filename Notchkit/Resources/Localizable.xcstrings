            "value" : "サウンド解析を開始できませんでした：%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar a análise de som: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
