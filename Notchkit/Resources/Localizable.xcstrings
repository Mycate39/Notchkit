    "Un brouillon toujours à portée de survol pour noter une idée." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Notizblock, nur einen Zeigerweg entfernt, um eine Idee festzuhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A scratchpad one hover away to jot down an idea."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bloc de notas a un paso del puntero para apuntar una idea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un brouillon toujours à portée de survol pour noter une idée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
