            "state" : "translated",
            "value" : "Estimate: %@%@. Compared with your largest session so far."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimación: %@%@. Comparado con tu sesión más grande hasta ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
