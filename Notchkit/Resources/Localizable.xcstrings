    "Localisation refusée : la ville choisie ci-dessous est utilisée. Vous pouvez l'autoriser dans Réglages Système > Confidentialité et sécurité > Service de localisation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standort verweigert: Die unten gewählte Stadt wird verwendet. Du kannst ihn unter Systemeinstellungen > Datenschutz & Sicherheit > Ortungsdienste erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location denied: the city chosen below is used. You can allow it in System Settings > Privacy & Security > Location Services."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubicación denegada: se usa la ciudad elegida abajo. Puedes permitirla en Ajustes del Sistema > Privacidad y seguridad > Localización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localisation refusée : la ville choisie ci-dessous est utilisée. Vous pouvez l'autoriser dans Réglages Système > Confidentialité et sécurité > Service de localisation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報が拒否されています：下で選んだ都市を使います。「システム設定」>「プライバシーとセキュリティ」>「位置情報サービス」で許可できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localização negada: a cidade escolhida abaixo é usada. Você pode permiti-la em Ajustes do Sistema > Privacidade e Segurança > Serviços de Localização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置访问被拒绝：将使用下方选择的城市。你可以在“系统设置”>“隐私与安全性”>“定位服务”中允许。"
          }
        }
      }
    },
