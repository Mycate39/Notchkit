    "Pendant une partie, l'encoche ne s'ouvre plus au survol et les alertes et bulles sont mises en pause." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während eines Spiels öffnet sich die Notch nicht mehr beim Darüberfahren, und Hinweise und Blasen pausieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During a game, the notch no longer opens on hover and alerts and bubbles are paused."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante una partida, el notch ya no se abre al pasar el puntero y los avisos y burbujas se pausan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant une partie, l'encoche ne s'ouvre plus au survol et les alertes et bulles sont mises en pause."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲーム中は、ポインタを重ねてもノッチが開かず、通知とバブルは一時停止します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante um jogo, o notch não abre mais ao passar o ponteiro, e os alertas e as bolhas ficam em pausa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏期间，指针悬停时刘海不再打开，提醒和气泡也会暂停。"
          }
        }
      }
    },
    "Pendant une partie, l'encoche se fait discrète et affiche la charge du processeur, de la carte graphique et l'état thermique." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während eines Spiels hält sich die Notch zurück und zeigt CPU- und GPU-Last sowie den thermischen Zustand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During a game, the notch stays out of the way and shows CPU and GPU load and the thermal state."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante una partida, el notch se aparta y muestra la carga de la CPU y la GPU y el estado térmico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant une partie, l'encoche se fait discrète et affiche la charge du processeur, de la carte graphique et l'état thermique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲーム中は、ノッチが控えめになり、CPUとGPUの負荷と温度状態を表示します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante um jogo, o notch sai do caminho e mostra a carga da CPU e da GPU e o estado térmico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏期间，刘海会退到一边，显示 CPU 和 GPU 负载以及温度状态。"
          }
        }
      }
    },
