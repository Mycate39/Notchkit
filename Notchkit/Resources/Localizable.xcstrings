    "Les captures d'écran faites depuis l'ouverture de votre session apparaîtront ici." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmfotos seit deiner Anmeldung erscheinen hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots taken since you logged in will appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas de pantalla hechas desde que iniciaste sesión aparecerán aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures d'écran faites depuis l'ouverture de votre session apparaîtront ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン以降に撮ったスクリーンショットがここに表示されます。"
