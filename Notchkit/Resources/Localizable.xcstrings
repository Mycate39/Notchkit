    },
    "La commande notchkit affiche dans l'encoche ce que font vos scripts : une notification, ou une activité en cours (build, tests, export) jusqu'à sa fin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Befehl notchkit zeigt in der Notch, was deine Skripte tun: eine Mitteilung oder eine laufende Aktivität (Build, Tests, Export) bis zu ihrem Ende."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The notchkit command shows what your scripts are doing in the notch: a notification, or an ongoing activity (build, tests, export) until it ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El comando notchkit muestra en el notch lo que hacen tus scripts: una notificación o una actividad en curso (compilación, pruebas, exportación) hasta que termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La commande notchkit affiche dans l'encoche ce que font vos scripts : une notification, ou une activité en cours (build, tests, export) jusqu'à sa fin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "notchkitコマンドは、スクリプトの動作をノッチに表示します：通知、または終了するまで進行中のアクティビティ（ビルド、テスト、書き出し）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O comando notchkit mostra no notch o que seus scripts estão fazendo: uma notificação ou uma atividade em andamento (build, testes, exportação) até terminar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "notchkit 命令会在刘海中显示脚本正在做什么：一条通知，或一个进行中的活动（构建、测试、导出），直到完成。"
          }
        }
      }
    },
