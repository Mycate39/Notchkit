    },
    "Vos widgets, leur disposition, l'apparence de l'encoche et la mascotte seront remplacés. Vous pourrez rétablir vos widgets depuis Réglages > Disposition." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Widgets, ihre Anordnung, das Aussehen der Notch und das Maskottchen werden ersetzt. Du kannst deine Widgets unter Einstellungen > Anordnung wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your widgets, their layout, the notch appearance and the mascot will be replaced. You can restore your widgets from Settings > Layout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus widgets, su disposición, la apariencia del notch y la mascota se reemplazarán. Podrás restaurar tus widgets desde Ajustes > Disposición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos widgets, leur disposition, l'apparence de l'encoche et la mascotte seront remplacés. Vous pourrez rétablir vos widgets depuis Réglages > Disposition."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェット、その配置、ノッチの外観、マスコットが置き換えられます。ウィジェットは「設定」>「配置」から元に戻せます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus widgets, o layout deles, a aparência do notch e o mascote serão substituídos. Você pode restaurar seus widgets em Ajustes > Layout."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的小组件、布局、刘海外观和吉祥物将被替换。你可以在“设置”>“布局”中恢复小组件。"
          }
        }
      }
    },
    "Votre accord" : {
      "localizations" : {
